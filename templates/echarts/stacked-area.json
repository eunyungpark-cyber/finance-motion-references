{
  "dataset": {
    "source": "$DATA"
  },
  "grid": {
    "left": 48,
    "right": 64,
    "top": 40,
    "bottom": 40,
    "containLabel": true
  },
  "legend": {
    "top": 0
  },
  "tooltip": {
    "trigger": "axis"
  },
  "xAxis": {
    "type": "category",
    "boundaryGap": false
  },
  "yAxis": {
    "type": "value"
  },
  "series": {
    "$seriesPerMeasure": {
      "type": "line",
      "stack": "total",
      "areaStyle": {},
      "symbol": "none"
    }
  },
  "animationDuration": 900,
  "animationEasing": "cubicOut",
  "_binding": {
    "columns": [
      "period",
      "<measure...>"
    ]
  }
}
